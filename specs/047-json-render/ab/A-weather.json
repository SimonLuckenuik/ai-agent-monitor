{
  "bg": "@bg",
  "items": [
    {"type": "text", "x": 120, "y": 48, "text": "{time.hm}", "font": "bebas", "size": 76, "align": "mc", "color": "@time", "bg": "@bg", "pad": 10},
    {"type": "text", "x": 120, "y": 96, "text": "{date.wday}  {date.text}", "font": 2, "align": "mc", "color": "@date", "bg": "@bg", "pad": 10},

    {"type": "icon", "x": 52, "y": 138, "size": 56, "icon": "{now.icon}", "color": "@icon", "bg": "@bg"},
    {"type": "text", "x": 92, "y": 126, "text": "{now.temp}°", "font": "big", "size": 30, "weight": 1.3, "align": "ml", "color": "@text", "bg": "@bg", "pad": 4},
    {"type": "text", "x": 92, "y": 154, "text": "{now.text:17}", "font": 2, "align": "ml", "color": "@muted", "bg": "@bg", "pad": 6},
    {"type": "line", "x": 16, "y": 170, "x2": 224, "y2": 170, "w": 1, "color": "@panel"},

    {"type": "repeat", "of": "days", "x": -62, "y": 174, "dx": 74, "items": [
      {"type": "rect", "x": 0, "y": 0, "w": 70, "h": 64, "r": 10, "color": "@panel", "show": "{it.index}>0"},
      {"type": "text", "x": 35, "y": 3, "text": "{it.wday3}", "font": 2, "align": "tc", "color": "@muted", "show": "{it.index}>0"},
      {"type": "icon", "x": 35, "y": 32, "size": 26, "icon": "{it.icon}", "color": "@icon", "show": "{it.index}>0"},
      {"type": "text", "x": 33, "y": 46, "text": "{it.high}", "font": 2, "align": "tr", "color": "@high", "show": "{it.index}>0"},
      {"type": "text", "x": 37, "y": 46, "text": "{it.low}", "font": 2, "align": "tl", "color": "@low", "show": "{it.index}>0"}
    ]}
  ]
}
