    {"type": "text", "x": 120, "y": 100, "text": "NOW", "font": "big", "size": 34, "weight": 1.5, "align": "mc", "color": "@accent", "show": "{mins|1}<=0"},

    {"type": "text", "x": 120, "y": 184, "text": "{meeting:15|Meeting}", "font": 4, "align": "mc", "color": "@fg"},
