     "$else": "#3ddc84"
    },
    "fill": "none"
   }
  },
  "ft": {
   "type": "Text",
   "props": {
    "text": {
     "$template": "${/vars/passed|0} passed, ${/vars/failed|0} failed"
    },
    "maxChars": 30,
    "color": {
     "$cond": {
      "$state": "/vars/failed",
      "gt": 0
