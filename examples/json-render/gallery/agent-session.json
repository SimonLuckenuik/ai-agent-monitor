{
 "root": "s",
 "elements": {
  "s": {
   "type": "Box",
   "props": {
    "flexDirection": "column",
    "padding": 1,
    "gap": 1,
    "backgroundColor": "#0c0a09"
   },
   "children": [
    "head",
    "task",
    "rule",
    "todo",
    "sp",
    "foot"
   ]
  },
  "head": {
   "type": "Box",
   "props": {
    "alignItems": "center",
    "gap": 1
   },
   "children": [
    "hi",
    "ha",
    "hsp",
    "spin"
   ]
  },
  "hi": {
   "type": "Icon",
   "props": {
    "d": [
     "m4 17 6-6-6-6",
     "M12 19h8"
    ],
    "size": 3,
    "color": "#d97757",
    "fill": "none",
    "strokeWidth": 2.5
   }
  },
  "ha": {
   "type": "Text",
   "props": {
    "text": {
     "$state": "/vars/agent",
     "fallback": "Claude Code"
    },
    "color": "#d97757",
    "maxChars": 18,
    "wrap": "truncate"
   }
  },
  "hsp": {
   "type": "Spacer",
   "props": {}
  },
  "spin": {
   "type": "Spinner",
   "props": {
    "label": {
     "$state": "/vars/state",
     "fallback": "idle"
    },
    "color": "#d97757"
   },
   "visible": {
    "$state": "/vars/state",
    "eq": "working"
   }
  },
  "task": {
   "type": "Text",
   "props": {
    "text": {
     "$state": "/vars/task",
     "fallback": "Waiting for a task"
    },
    "color": "#ffffff",
    "maxChars": 76,
    "wrap": "wrap"
   }
  },
  "rule": {
   "type": "Divider",
   "props": {
    "title": {
     "$template": "${/vars/done|0} of 4 done"
    },
    "color": "#3a2f2a"
   }
  },
  "todo": {
   "type": "Box",
   "props": {
    "flexDirection": "column"
   },
   "children": [
    "t1",
    "t2",
    "t3",
    "t4"
   ]
  },
  "t1": {
   "type": "Box",
   "props": {
    "alignItems": "center",
    "gap": 1
   },
   "children": [
    "t1i",
    "t1t"
   ]
  },
  "t1i": {
   "type": "Icon",
   "props": {
    "d": [
     "M20 6 9 17l-5-5"
    ],
    "size": 3,
    "color": {
     "$cond": {
      "$state": "/vars/done",
      "gte": 1
     },
     "$then": "#3ddc84",
     "$else": {
      "$cond": {
       "$state": "/vars/done",
       "eq": 0
      },
      "$then": "#d97757",
      "$else": "#3a3330"
     }
    },
    "fill": "none",
    "strokeWidth": 3
   }
  },
  "t1t": {
   "type": "Text",
   "props": {
    "text": {
     "$state": "/vars/todo1",
     "fallback": ""
    },
    "maxChars": 34,
    "wrap": "truncate",
    "color": {
     "$cond": {
      "$state": "/vars/done",
      "gte": 1
     },
     "$then": "#6b625d",
     "$else": {
      "$cond": {
       "$state": "/vars/done",
       "eq": 0
      },
      "$then": "#ffffff",
      "$else": "#a8a29e"
     }
    }
   }
  },
  "t2": {
   "type": "Box",
   "props": {
    "alignItems": "center",
    "gap": 1
   },
   "children": [
    "t2i",
    "t2t"
   ]
  },
