{
 "root": "s",
 "elements": {
  "s": {
   "type": "Box",
   "props": {
    "flexDirection": "column",
    "padding": 1,
    "gap": 1,
    "backgroundColor": "#07090c"
   },
   "children": [
    "head",
    "main",
    "spark"
   ]
  },
  "head": {
   "type": "Box",
   "props": {
    "alignItems": "center",
    "gap": 1
   },
   "children": [
    "hi",
    "ht",
    "hsp",
    "hc"
   ]
  },
  "hi": {
   "type": "Icon",
   "props": {
    "d": [
     "M13 2 3 14h9l-1 8 10-12h-9l1-8z"
    ],
    "size": 3,
    "color": "#ffd23f",
    "fill": "none"
   }
  },
  "ht": {
   "type": "Text",
   "props": {
    "text": "Energy",
    "fontSize": 26,
    "color": "#ffffff"
   }
  },
  "hsp": {
   "type": "Spacer",
   "props": {}
  },
  "hc": {
   "type": "Clock",
   "props": {
    "format": "hm",
    "fontSize": 16,
    "color": "@muted",
    "align": "right"
   }
  },
  "main": {
   "type": "Box",
   "props": {
    "alignItems": "center",
    "gap": 2
   },
   "children": [
    "bat",
    "flows"
   ]
  },
  "bat": {
   "type": "Ring",
   "props": {
    "value": {
     "$state": "/vars/battery",
     "fallback": "0"
    },
    "max": 100,
    "size": 12,
    "thickness": 2,
    "color": {
     "$cond": {
      "$state": "/vars/battery",
      "lt": 20
     },
     "$then": "#ff5a5a",
     "$else": "#3ddc84"
    },
    "track": "#1a2129",
    "label": {
     "$template": "${/vars/battery|0}%"
    }
   }
  },
  "flows": {
   "type": "Box",
   "props": {
    "flexDirection": "column",
    "gap": 1,
    "flexGrow": 1
   },
   "children": [
    "fs",
    "fh",
    "fg"
   ]
  },
  "fs": {
   "type": "Box",
   "props": {
    "alignItems": "center",
    "gap": 1
   },
   "children": [
    "fsi",
    "fsl",
    "fssp",
    "fsv"
   ]
  },
  "fsi": {
   "type": "Icon",
   "props": {
    "d": [
     "M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0z",
     "M12 2v2",
     "M12 20v2",
     "m4.93 4.93 1.41 1.41",
     "m17.66 17.66 1.41 1.41",
     "M2 12h2",
     "M20 12h2",
     "m6.34 17.66-1.41 1.41",
     "m19.07 4.93-1.41 1.41"
    ],
    "size": 3,
    "color": "#ffd23f",
    "fill": "none"
   }
  },
  "fsl": {
   "type": "Text",
   "props": {
    "text": "Solar",
    "color": "@muted"
   }
  },
  "fssp": {
   "type": "Spacer",
   "props": {}
  },
  "fsv": {
   "type": "Text",
   "props": {
    "text": {
     "$template": "${/vars/solar|0} kW"
    },
    "color": "#ffd23f",
    "align": "right",
    "maxChars": 8
   }
  },
  "fh": {
   "type": "Box",
   "props": {
    "alignItems": "center",
    "gap": 1
   },
   "children": [
    "fhi",
    "fhl",
    "fhsp",
    "fhv"
   ]
  },
  "fhi": {
   "type": "Icon",
   "props": {
    "d": [
     "m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z",
     "M9 22V12h6v10"
    ],
    "size": 3,
    "color": "#9fc4ff",
    "fill": "none"
   }
  },
  "fhl": {
   "type": "Text",
   "props": {
    "text": "House",
    "color": "@muted"
   }
  },
  "fhsp": {
   "type": "Spacer",
   "props": {}
  },
  "fhv": {
   "type": "Text",
   "props": {
    "text": {
     "$template": "${/vars/house|0} kW"
    },
    "color": "#ffffff",
    "align": "right",
    "maxChars": 8
   }
  },
  "fg": {
   "type": "Box",
   "props": {
    "alignItems": "center",
    "gap": 1
   },
   "children": [
    "fgi",
    "fgl",
    "fgsp",
    "fgv"
   ]
  },
  "fgi": {
   "type": "Icon",
   "props": {
    "d": [
     "M12 22v-5",
     "M9 8V2",
     "M15 8V2",
     "M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"
    ],
    "size": 3,
    "color": {
     "$cond": {
      "$state": "/vars/grid",
      "lt": 0
     },
     "$then": "#3ddc84",
     "$else": "#ff8a3d"
    },
    "fill": "none"
   }
  },
  "fgl": {
   "type": "Text",
   "props": {
    "text": "Grid",
    "color": "@muted"
   }
  },
  "fgsp": {
   "type": "Spacer",
   "props": {}
  },
  "fgv": {
   "type": "Text",
   "props": {
    "text": {
     "$template": "${/vars/grid|0} kW"
    },
    "color": {
     "$cond": {
      "$state": "/vars/grid",
      "lt": 0
     },
     "$then": "#3ddc84",
     "$else": "#ff8a3d"
    },
    "align": "right",
    "maxChars": 8
   }
  },
  "spark": {
   "type": "Sparkline",
   "props": {
    "state": "/vars/solar",
    "label": "Solar today",
    "color": "#ffd23f",
    "min": 0,
    "height": 3
   }
  }
 },
 "state": {
  "vars": {
   "battery": 76,
   "solar": 3.4,
   "house": 1.2,
   "grid": -2.2
  }
 }
}
