{
 "root": "screen",
 "elements": {
  "screen": {
   "type": "Box",
   "props": {"flexDirection": "column", "paddingTop": 1, "paddingBottom": 1, "paddingLeft": 2, "paddingRight": 2, "backgroundColor": {"$cond": {"$state": "/vars/mins", "lte": 5}, "$then": "#4a0008", "$else": "#06080c"}},
   "children": ["header", "title", "roomRow", "fill", "label", "count"]
  },
  "header": {
   "type": "Box",
   "props": {"alignItems": "center", "gap": 1, "marginBottom": 1},
   "children": ["calIcon", "kicker", "hsp", "time"]
  },
  "calIcon": {
   "type": "Icon",
   "props": {"d": ["M8 2v4", "M16 2v4", "M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z", "M3 10h18"], "size": 3, "color": "@muted", "fill": "none"}
  },
  "kicker": {
   "type": "Text",
   "props": {"text": "NEXT MEETING", "color": "@muted"}
  },
  "hsp": {"type": "Spacer"},
  "time": {
   "type": "Clock",
   "props": {"format": "hm", "fontSize": 16, "color": "@muted", "align": "right"}
  },
  "title": {
   "type": "Text",
   "props": {"text": {"$state": "/vars/meeting", "fallback": "Meeting"}, "fontSize": 26, "color": "#ffffff", "wrap": "wrap", "maxChars": 30}
  },
  "roomRow": {
   "type": "Box",
   "props": {"alignItems": "center", "gap": 1, "marginTop": 1},
   "children": ["pin", "room"]
  },
  "pin": {
   "type": "Icon",
   "props": {"d": ["M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z", "M15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"], "size": 3, "color": "#5ab4ff", "fill": "none"}
  },
  "room": {
   "type": "Text",
   "props": {"text": {"$state": "/vars/room", "fallback": "-"}, "color": "#5ab4ff", "maxChars": 30, "wrap": "truncate"}
  },
  "fill": {"type": "Spacer"},
  "label": {
   "type": "Text",
   "props": {
    "text": {"$cond": {"$state": "/vars/mins", "lte": 5}, "$then": " STARTING SOON ", "$else": "STARTS IN"},
    "color": {"$cond": {"$state": "/vars/mins", "lte": 5}, "$then": "#4a0008", "$else": "@muted"},
    "backgroundColor": {"$cond": {"$state": "/vars/mins", "lte": 5}, "$then": "#ffd0d0", "$else": "#06080c"},
    "maxChars": 15
   }
  },
  "count": {
   "type": "Box",
   "props": {"alignItems": "flex-end", "gap": 1},
   "children": ["mins", "unit"]
  },
  "mins": {
   "type": "Text",
   "props": {"text": {"$state": "/vars/mins", "fallback": "0"}, "font": "big", "fontSize": 72, "bold": true, "maxChars": 3, "color": {"$cond": {"$state": "/vars/mins", "lte": 5}, "$then": "#ffffff", "$else": "#ffb020"}}
  },
  "unit": {
   "type": "Text",
   "props": {"text": "MIN", "fontSize": 26, "color": {"$cond": {"$state": "/vars/mins", "lte": 5}, "$then": "#ffd0d0", "$else": "@muted"}}
  }
 },
 "state": {
  "vars": {"meeting": "Design review", "room": "Lab 2", "mins": 12}
 }
}
