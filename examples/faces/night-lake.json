    {"type": "circle", "x": "120-104*cos(180*(1-{sun.until_set}/{sun.daylen}))", "y": "172-140*sin(180*(1-{sun.until_set}/{sun.daylen}))", "r": 13, "color": "@sun", "show": "{sun.up}"},
