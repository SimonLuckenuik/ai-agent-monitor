    {"type": "repeat", "of": 3, "show": "{sun.up}", "items": [{"type": "line", "x": "106+5*{it.index}-104*cos(180*(1-{sun.until_set}/{sun.daylen}))", "y": "180+7*{it.index}", "x2": "134-5*{it.index}-104*cos(180*(1-{sun.until_set}/{sun.daylen}))", "y2": "180+7*{it.index}", "w": 2, "color": "{it.index}==0?@g1:{it.index}==1?@g2:@g3"}]},
    {"type": "repeat", "of": 3, "show": "!{sun.up}", "items": [{"type": "line", "x": "106+5*{it.index}-104*cos(180*(1-{sun.until_rise}/(1440-{sun.daylen})))", "y": "180+7*{it.index}", "x2": "134-5*{it.index}-104*cos(180*(1-{sun.until_rise}/(1440-{sun.daylen})))", "y2": "180+7*{it.index}", "w": 2, "color": "{it.index}==0?@g1:{it.index}==1?@g2:@g3"}]},
    {"type": "line", "x": 108, "y": 178, "x2": 114, "y2": 178, "w": 2, "color": "#7a6430", "show": "!{sun.up}"},
    {"type": "text", "x": 16, "y": 216, "text": "{time.hm}", "font": 4, "align": "ml", "color": "@ink", "bg": "@lake", "pad": 96},
    {"type": "text", "x": 224, "y": 206, "text": "{date.wday3} {date.day}", "font": 2, "align": "mr", "color": "@sub", "bg": "@lake", "pad": 80},
    {"type": "text", "x": 224, "y": 226, "text": "{now.temp|--} {units.temp}", "font": 2, "align": "mr", "color": "@sub", "bg": "@lake", "pad": 80}
  ]
