{
  "maps": {"agent": {"running": "#7dd3fc", "waiting": "#febc2e", "fail": "#ff5f57", "done": "#39ff88", "*": "#5f735f"}},
  "bg": "#0b0f0b",
  "items": [
    {"type": "rect", "x": 0, "y": 0, "w": 240, "h": 22, "color": "#1d261d"},
    {"type": "circle", "x": 12, "y": 11, "r": 4, "color": "#ff5f57"},
    {"type": "circle", "x": 25, "y": 11, "r": 4, "color": "#febc2e"},
    {"type": "circle", "x": 38, "y": 11, "r": 4, "color": "#28c840"},
    {"type": "text", "x": 132, "y": 11, "text": "agent@monitor: ~", "font": 2, "align": "mc", "color": "#5f735f"},
    {"type": "text", "x": 8, "y": 30, "text": "$ date", "font": 2, "color": "#7dd3fc"},
    {"type": "text", "x": 8, "y": 47, "text": "{date.wday}, {date.text} {date.year}", "font": 2, "color": "#39ff88", "bg": "#0b0f0b", "pad": 224},
    {"type": "text", "x": 8, "y": 70, "text": "$ clock --now", "font": 2, "color": "#7dd3fc"},
    {"type": "text", "x": 8, "y": 90, "text": "{time.hm}", "font": 6, "color": "#39ff88", "bg": "#0b0f0b", "pad": 224},
    {"type": "text", "x": 8, "y": 146, "text": "$ weather", "font": 2, "color": "#7dd3fc"},
    {"type": "text", "x": 8, "y": 163, "text": "{loc.city|here}: {now.temp|--} {units.temp}, {now.text|}", "font": 2, "color": "#39ff88", "bg": "#0b0f0b", "pad": 224},
    {"type": "text", "x": 8, "y": 186, "text": "$ agent status", "font": 2, "color": "#7dd3fc"},
    {"type": "text", "x": 232, "y": 186, "text": "{round({age.agent}/60)} min ago", "font": 2, "align": "tr", "color": "#5f735f", "show": "{age.agent}"},
    {"type": "text", "x": 8, "y": 203, "text": "{agent|idle}", "font": 2, "color": "{agent:agent}", "bg": "#0b0f0b", "pad": 224},
    {"type": "text", "x": 8, "y": 222, "text": "$", "font": 2, "color": "#7dd3fc"},
    {"type": "text", "x": 20, "y": 222, "text": "_", "font": 2, "color": "{time.sec}%2==0?#39ff88:#0b0f0b", "bg": "#0b0f0b"}
  ]
}
